# Générer avec : python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=remplacer-par-une-cle-aleatoire

# Générer avec : docker compose run --rm --entrypoint flask app --app app hash-password
GM_PASSWORD_HASH=remplacer-par-le-hash-du-mot-de-passe-mj

# true uniquement lorsque l'application est publiée derrière HTTPS.
SESSION_COOKIE_SECURE=false

# API de fiche publique pendant la phase de test.
API_PUBLIC=true
API_CORS_ORIGIN=*

# Réglages facultatifs.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
