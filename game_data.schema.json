{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-manager.local/schemas/game-data-v2.json",
  "title": "D&D Manager ruleset",
  "type": "object",
  "required": [
    "schema_version",
    "ruleset",
    "definitions",
    "classes",
    "races"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "ruleset": {
      "type": "object",
      "required": ["id", "name", "version", "locale"]
    },
    "definitions": {
      "type": "object",
      "required": ["abilities", "defenses", "damage_types", "rest_types"]
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/characterOption"
      }
    },
    "races": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/characterOption"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identified": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "characterOption": {
      "allOf": [
        {
          "$ref": "#/$defs/identified"
        },
        {
          "type": "object",
          "required": ["paths"],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
